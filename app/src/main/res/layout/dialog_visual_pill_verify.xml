<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_camera"
            app:tint="@color/brand_accent" />

        <TextView
            android:id="@+id/tvVerifyPillTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Visual Pill Verification"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseVerify"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Close Pill Verification"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVerifyMedDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Lisinopril 10 mg • Round Pink Tablet"
        android:textColor="@color/brand_primary_light"
        android:textSize="14sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="14dp"
        android:background="#0A0F1D">

        <ImageView
            android:id="@+id/imgVerifiedPillPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/app_logo" />

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVerifyImprintOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="10dp"
            android:background="#CC0F172A"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="Verified Imprint: L 10"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSnapPhoto"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="Photograph My Actual Pill / Bottle"
        android:textColor="@color/brand_accent"
        app:icon="@drawable/ic_camera"
        app:iconTint="@color/brand_accent" />

    <TextView
        android:id="@+id/tvVerifyInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#131B2E"
        android:padding="10dp"
        android:text="Dosage Guide: Take 1 tablet every morning with full glass of water. Confirm pill matches pink round shape with 'L 10' engraving."
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmPillMatch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/brand_primary"
        android:text="✓ Matches My Pill — Safe to Take"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

</LinearLayout>
