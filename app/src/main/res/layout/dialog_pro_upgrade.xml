<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/pro_gold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="MedVault Pro"
                android:textColor="@color/pro_gold"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnClosePro"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Maximum safety for high-stakes medication management"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#131B2E"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Unlimited Medications &amp; Vitamins (Free capped at 3)"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="✓ Doctor-Ready 1-Page PDF Clinical Adherence Reports"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="✓ Visual Pill Camera Verification &amp; Label OCR Scanner"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="✓ Automated Family &amp; Caregiver Missed-Dose SMS Alerts"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/rgPricing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <RadioButton
                android:id="@+id/rbLifetime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_widget_safe"
                android:checked="true"
                android:padding="12dp"
                android:text="⭐ $29.99 Lifetime Unlock (Best Value • One-time)"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbAnnual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="#131B2E"
                android:padding="12dp"
                android:text="📅 $19.99 / Year ($1.66/mo • Save 44%)"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbMonthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#131B2E"
                android:padding="12dp"
                android:text="📆 $2.99 / Month"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPurchasePro"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/pro_gold"
            android:text="Upgrade to MedVault Pro"
            android:textColor="@color/bg_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestUnlockToggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🧪 Demo/Test Mode: Toggle Pro Unlock"
            android:textColor="@color/brand_primary_light"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="100% Privacy-Guaranteed • Zero Ads • No Medical Data Selling"
            android:textColor="@color/text_muted"
            android:textSize="10.5sp" />

    </LinearLayout>

</ScrollView>
