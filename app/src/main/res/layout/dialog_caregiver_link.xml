<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_caregiver"
            app:tint="@color/brand_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Caregiver Family Link"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseCaregiver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Close Caregiver Link"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Keeps adult children &amp; caregivers connected if critical doses are missed"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#131B2E"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvCaregiverNameDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Caregiver: David Vance (Son)"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCaregiverPhoneDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mobile: +1 (555) 432-1987"
            android:textColor="@color/brand_primary_light"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Critical Dose Monitor: Lisinopril 10mg (Blood Pressure) &amp; Metformin 500mg"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendCaregiverSms"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/brand_primary"
        android:text="Send Missed-Dose SMS Alert"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:icon="@drawable/ic_caregiver"
        app:iconTint="@color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCallCaregiver"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="Call Caregiver Directly"
        android:textColor="@color/brand_accent" />

</LinearLayout>
